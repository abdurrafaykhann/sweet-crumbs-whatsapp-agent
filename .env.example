# Copy to .env and fill in. Never commit .env.
# ---- LLM (free tiers; used from milestone M3) ----
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY=groq:openai/gpt-oss-120b
LLM_FALLBACK=google_genai:gemini-flash-lite-latest
# LLM_JUDGE=   # optional; default is a small model from the other provider than the bot (groq:openai/gpt-oss-20b or gemini-flash-lite)
# ---- infrastructure ----
DATABASE_URL=sqlite:///./sweetcrumbs.db
REDIS_URL=
# ---- WhatsApp Cloud API ----
WA_VERIFY_TOKEN=dev-verify-token
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
# ---- admin dashboard at /admin: both are needed; JWT_SECRET must be 16+ characters (python -c "import secrets;print(secrets.token_urlsafe(32))") ----
ADMIN_PASSWORD=
JWT_SECRET=
# optional: a second, read-only dashboard password for a public demo (can look, cannot change anything)
DEMO_PASSWORD=
# ---- demo ----
# 1 = load data/sweet-crumbs-bakery-demo.md on first start when the database is empty
SEED_ON_START=1
# Fixed "today" for repeatable demos and tests (spec: Friday 6 November 2026). Empty = real clock.
DEMO_NOW=2026-11-06T14:00:00
